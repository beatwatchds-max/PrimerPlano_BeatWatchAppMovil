<?xml version="1.0" encoding="utf-8"?>
<!-- Fondo del input de token: blanco, borde gris claro, esquinas redondeadas.
     Al enfocarse, el borde cambia al azul principal. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/white" />
            <stroke android:width="1.5dp" android:color="@color/beatwatch_blue" />
            <corners android:radius="14dp" />
        </shape>
    </item>

    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/white" />
            <stroke android:width="1dp" android:color="@color/input_border" />
            <corners android:radius="14dp" />
        </shape>
    </item>

</selector>
