<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/beatwatch_background"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Resumen Semanal" android:textColor="@color/beatwatch_dark_blue" android:textSize="24sp" android:textStyle="bold" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="Resumen de salud y actividad" android:textColor="#6B7A90" android:textSize="14sp" />

        <ProgressBar android:id="@+id/progressReportes" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="center" android:layout_marginTop="36dp" android:indeterminateTint="@color/beatwatch_blue" android:visibility="gone" />
        <TextView android:id="@+id/tvReportesError" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="36dp" android:gravity="center" android:textColor="@color/beatwatch_heart" android:textSize="14sp" android:visibility="gone" />

        <LinearLayout
            android:id="@+id/reportesContent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="18dp" android:background="@color/white" android:elevation="2dp" android:gravity="center_vertical" android:orientation="horizontal" android:padding="16dp">
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="PERÍODO DE CONSULTA" android:textColor="#6B7A90" android:textSize="11sp" />
                    <TextView android:id="@+id/tvPeriodoTexto" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:textColor="@color/beatwatch_dark_blue" android:textSize="16sp" android:textStyle="bold" />
                </LinearLayout>
                <TextView android:id="@+id/tvCambiarPeriodo" android:layout_width="wrap_content" android:layout_height="wrap_content" android:clickable="true" android:focusable="true" android:padding="8dp" android:text="Cambiar" android:textColor="@color/beatwatch_blue" android:textStyle="bold" />
            </LinearLayout>

            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="22dp" android:text="Resumen del período" android:textColor="@color/beatwatch_dark_blue" android:textSize="17sp" android:textStyle="bold" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:orientation="horizontal">
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginEnd="6dp" android:layout_weight="1" android:background="@color/white" android:elevation="2dp" android:gravity="center" android:orientation="vertical" android:padding="14dp"><TextView android:id="@+id/tvBpmPromedio" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@color/beatwatch_heart" android:textSize="20sp" android:textStyle="bold" /><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="BPM promedio" android:textColor="#6B7A90" android:textSize="11sp" /></LinearLayout>
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="6dp" android:layout_weight="1" android:background="@color/white" android:elevation="2dp" android:gravity="center" android:orientation="vertical" android:padding="14dp"><TextView android:id="@+id/tvArritmias" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@color/beatwatch_heart" android:textSize="20sp" android:textStyle="bold" /><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Arritmias" android:textColor="#6B7A90" android:textSize="11sp" /></LinearLayout>
            </LinearLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:orientation="horizontal">
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginEnd="6dp" android:layout_weight="1" android:background="@color/white" android:elevation="2dp" android:gravity="center" android:orientation="vertical" android:padding="14dp"><TextView android:id="@+id/tvPasos" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@color/beatwatch_blue" android:textSize="20sp" android:textStyle="bold" /><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Pasos" android:textColor="#6B7A90" android:textSize="11sp" /></LinearLayout>
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="6dp" android:layout_weight="1" android:background="@color/white" android:elevation="2dp" android:gravity="center" android:orientation="vertical" android:padding="14dp"><TextView android:id="@+id/tvSueno" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@color/beatwatch_blue" android:textSize="20sp" android:textStyle="bold" /><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Sueño promedio" android:textColor="#6B7A90" android:textSize="11sp" /></LinearLayout>
            </LinearLayout>

        </LinearLayout>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
