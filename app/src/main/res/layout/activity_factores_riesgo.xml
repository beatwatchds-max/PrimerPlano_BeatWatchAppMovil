<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/beatwatch_background"
    android:fillViewport="true">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="24dp">

        <!-- Logo: corazón + texto BEATWATCH -->
        <LinearLayout
            android:id="@+id/logoContainer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            app:layout_constraintBottom_toTopOf="@id/formCard"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_chainStyle="packed">

            <ImageView
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:contentDescription="@string/app_name"
                android:src="@drawable/ic_heart_outline" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:letterSpacing="0.05"
                android:text="@string/app_name"
                android:textColor="@color/beatwatch_blue"
                android:textSize="24sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Card blanca del formulario -->
        <LinearLayout
            android:id="@+id/formCard"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:background="@drawable/bg_login_card"
            android:elevation="6dp"
            android:orientation="vertical"
            android:padding="22dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/logoContainer"
            app:layout_constraintWidth_percent="0.88">

            <!-- Encabezado: ícono escudo + título -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:contentDescription="@string/factores_title"
                    android:src="@drawable/ic_shield_outline" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:text="@string/factores_title"
                    android:textColor="@color/beatwatch_dark_blue"
                    android:textSize="20sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Descripción -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:lineSpacingExtra="4dp"
                android:text="@string/factores_descripcion"
                android:textColor="#6B7A90"
                android:textSize="13sp" />

            <!-- ==================== CHECKBOXES ==================== -->

            <CheckBox
                android:id="@+id/cbHipertension"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:buttonTint="@color/beatwatch_blue"
                android:paddingVertical="6dp"
                android:text="Hipertensión arterial"
                android:textColor="@color/beatwatch_dark_blue"
                android:textSize="14sp" />

            <CheckBox
                android:id="@+id/cbObesidad"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:buttonTint="@color/beatwatch_blue"
                android:paddingVertical="6dp"
                android:text="Obesidad o IMC elevado"
                android:textColor="@color/beatwatch_dark_blue"
                android:textSize="14sp" />

            <CheckBox
                android:id="@+id/cbApnea"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:buttonTint="@color/beatwatch_blue"
                android:paddingVertical="6dp"
                android:text="Apnea del sueño"
                android:textColor="@color/beatwatch_dark_blue"
                android:textSize="14sp" />

            <CheckBox
                android:id="@+id/cbTabaquismo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:buttonTint="@color/beatwatch_blue"
                android:paddingVertical="6dp"
                android:text="Tabaquismo"
                android:textColor="@color/beatwatch_dark_blue"
                android:textSize="14sp" />

            <CheckBox
                android:id="@+id/cbAlcoholismo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:buttonTint="@color/beatwatch_blue"
                android:paddingVertical="6dp"
                android:text="Alcoholismo"
                android:textColor="@color/beatwatch_dark_blue"
                android:textSize="14sp" />

            <CheckBox
                android:id="@+id/cbEstres"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:buttonTint="@color/beatwatch_blue"
                android:paddingVertical="6dp"
                android:text="Estrés crónico"
                android:textColor="@color/beatwatch_dark_blue"
                android:textSize="14sp" />

            <!-- ==================== BOTÓN CONTINUAR ==================== -->
            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnContinuarFactores"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="24dp"
                android:background="@drawable/bg_primary_button"
                android:text="@string/registro_continuar"
                android:textAllCaps="false"
                android:textColor="@color/white"
                android:textSize="15sp"
                android:textStyle="bold" />

        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>
