<?xml version="1.0" encoding="utf-8"?>
<!--
  Pantalla de Login - BEATWATCH
  ScrollView (fillViewport) para centrar el contenido y permitir scroll
  cuando el teclado está abierto. ConstraintLayout centra logo + card
  como un grupo (cadena vertical "packed").
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/beatwatch_background"
    android:fillViewport="true">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="24dp">

        <!-- Logo: corazón + texto BEATWATCH, alineados horizontalmente -->
        <LinearLayout
            android:id="@+id/logoContainer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            app:layout_constraintBottom_toTopOf="@id/loginCard"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_chainStyle="packed">

            <ImageView
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:contentDescription="@string/app_name"
                android:src="@drawable/ic_heart_outline" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:letterSpacing="0.05"
                android:text="@string/app_name"
                android:textColor="@color/beatwatch_blue"
                android:textSize="24sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Card blanca del login (88% del ancho, centrada, con sombra ligera) -->
        <LinearLayout
            android:id="@+id/loginCard"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:background="@drawable/bg_login_card"
            android:elevation="6dp"
            android:orientation="vertical"
            android:padding="24dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/logoContainer"
            app:layout_constraintWidth_percent="0.88">

            <!-- Título -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="@string/login_title"
                android:textColor="@color/beatwatch_dark_blue"
                android:textSize="20sp"
                android:textStyle="bold" />

            <!-- Label Token -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="@string/login_token_label"
                android:textColor="@color/beatwatch_dark_blue"
                android:textSize="14sp" />

            <!-- Campo de token -->
            <EditText
                android:id="@+id/etToken"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_token_input"
                android:hint="@string/login_token_hint"
                android:importantForAutofill="no"
                android:inputType="textPassword"
                android:paddingHorizontal="16dp"
                android:singleLine="true"
                android:textColor="@color/beatwatch_dark_blue"
                android:textColorHint="@color/placeholder_gray"
                android:textSize="14sp" />

            <!-- Botón Iniciar sesión -->
            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnLogin"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="24dp"
                android:background="@drawable/bg_primary_button"
                android:text="@string/login_button"
                android:textAllCaps="false"
                android:textColor="@color/white"
                android:textSize="15sp"
                android:textStyle="bold" />

        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>
