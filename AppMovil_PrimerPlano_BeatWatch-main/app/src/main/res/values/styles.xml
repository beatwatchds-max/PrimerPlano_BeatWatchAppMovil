<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="LabelForm">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">12dp</item>
        <item name="android:textColor">@color/beatwatch_dark_blue</item>
        <item name="android:textSize">13sp</item>
    </style>

    <style name="InputForm">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">48dp</item>
        <item name="android:layout_marginTop">6dp</item>
        <item name="android:layout_marginBottom">8dp</item>
        <item name="android:background">@drawable/bg_token_input</item>
        <item name="android:paddingHorizontal">16dp</item>
        <item name="android:singleLine">true</item>
        <item name="android:textColor">@color/beatwatch_dark_blue</item>
        <item name="android:textColorHint">@color/placeholder_gray</item>
        <item name="android:textSize">14sp</item>
        <item name="android:importantForAutofill">no</item>
    </style>
</resources>
