<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/white"
    android:elevation="2dp"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="14dp"
    android:outlineProvider="background">

    <FrameLayout
        android:id="@+id/contenedorIcono"
        android:layout_width="40dp"
        android:layout_height="40dp">

        <View
            android:id="@+id/vwIndicadorColor"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_circle_indicator" />

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_gravity="center"
            android:contentDescription="Icono"
            android:src="@drawable/ic_heart_outline" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvTipoHistorial"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/beatwatch_dark_blue"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvFechaHistorial"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="#6B7A90"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/tvDuracionHistorial"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            android:textColor="#6B7A90"
            android:textSize="12sp"
            android:visibility="gone" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tvBpmHistorial"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/beatwatch_dark_blue"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="2dp"
            android:text="bpm"
            android:textColor="#6B7A90"
            android:textSize="11sp" />
    </LinearLayout>

</LinearLayout>
