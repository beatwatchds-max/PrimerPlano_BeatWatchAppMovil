<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/beatwatch_background"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Historial"
            android:textColor="@color/beatwatch_blue"
            android:textSize="20sp"
            android:textStyle="bold" />

        <!-- Card: Tendencia semanal -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@color/white"
            android:elevation="2dp"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Tendencia semanal"
                android:textColor="@color/beatwatch_dark_blue"
                android:textSize="16sp"
                android:textStyle="bold" />

            <com.beatwatch.app.WeeklyTrendView
                android:id="@+id/weeklyTrendView"
                android:layout_width="match_parent"
                android:layout_height="200dp"
                android:layout_marginTop="8dp" />
        </LinearLayout>

        <!-- Sección: Registros recientes -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="Registros recientes"
            android:textColor="@color/beatwatch_dark_blue"
            android:textSize="16sp"
            android:textStyle="bold" />

        <!-- Loading -->
        <ProgressBar
            android:id="@+id/progressHistorial"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginTop="30dp"
            android:indeterminateTint="@color/beatwatch_blue"
            android:visibility="gone" />

        <!-- Empty state -->
        <TextView
            android:id="@+id/tvHistorialVacio"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="30dp"
            android:gravity="center"
            android:text="Aún no hay registros en el historial."
            android:textColor="#6B7A90"
            android:textSize="14sp"
            android:visibility="gone" />

        <!-- Error state -->
        <TextView
            android:id="@+id/tvHistorialError"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="30dp"
            android:gravity="center"
            android:textColor="@color/beatwatch_heart"
            android:textSize="14sp"
            android:visibility="gone" />

        <!-- Lista de registros -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvHistorial"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="20dp"
            android:nestedScrollingEnabled="false" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:visibility="gone" />

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
