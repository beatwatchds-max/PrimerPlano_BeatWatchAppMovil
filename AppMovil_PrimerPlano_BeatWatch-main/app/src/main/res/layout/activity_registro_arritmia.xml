<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/beatwatch_background"
    android:fillViewport="true">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="24dp">

        <!-- Logo: corazón + texto BEATWATCH -->
        <LinearLayout
            android:id="@+id/logoContainer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            app:layout_constraintBottom_toTopOf="@id/formCard"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_chainStyle="packed">

            <ImageView
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:contentDescription="@string/app_name"
                android:src="@drawable/ic_heart_outline" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:letterSpacing="0.05"
                android:text="@string/app_name"
                android:textColor="@color/beatwatch_blue"
                android:textSize="24sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Card blanca del formulario -->
        <LinearLayout
            android:id="@+id/formCard"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:background="@drawable/bg_login_card"
            android:elevation="6dp"
            android:orientation="vertical"
            android:padding="22dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/logoContainer"
            app:layout_constraintWidth_percent="0.88">

            <!-- Título: Registro de la Arritmia -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="@string/arritmia_title"
                android:textColor="@color/beatwatch_dark_blue"
                android:textSize="20sp"
                android:textStyle="bold" />

            <!-- ==================== TIPO DE ARRITMIA ==================== -->
            <TextView
                style="@style/LabelForm"
                android:layout_marginTop="20dp"
                android:text="@string/label_tipo_arritmia" />

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="6dp"
                android:layout_marginBottom="8dp">

                <Spinner
                    android:id="@+id/spTipoArritmia"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:background="@drawable/bg_token_input"
                    android:paddingHorizontal="16dp" />

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_gravity="center_vertical|end"
                    android:layout_marginEnd="12dp"
                    android:clickable="false"
                    android:focusable="false"
                    android:src="@drawable/ic_arrow_down"
                    android:importantForAccessibility="no" />
            </FrameLayout>

            <!-- ==================== FRECUENCIA CARDÍACA ==================== -->
            <TextView
                style="@style/LabelForm"
                android:text="@string/label_frecuencia_cardiaca" />

            <EditText
                android:id="@+id/etFrecuenciaCardiaca"
                style="@style/InputForm"
                android:hint="@string/hint_frecuencia_cardiaca"
                android:inputType="number" />

            <!-- ==================== DURACIÓN DE EPISODIO ==================== -->
            <TextView
                style="@style/LabelForm"
                android:text="@string/label_duracion_episodio" />

            <EditText
                android:id="@+id/etDuracionEpisodio"
                style="@style/InputForm"
                android:hint="Duración en minutos"
                android:inputType="number" />

            <!-- ==================== SÍNTOMAS PRESENTADOS ==================== -->
            <TextView
                style="@style/LabelForm"
                android:text="@string/label_sintomas" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:layout_marginBottom="8dp"
                android:orientation="vertical">

                <CheckBox
                    android:id="@+id/cbMareo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:buttonTint="@color/beatwatch_blue"
                    android:paddingVertical="4dp"
                    android:text="Mareo"
                    android:textColor="@color/beatwatch_dark_blue"
                    android:textSize="14sp" />

                <CheckBox
                    android:id="@+id/cbPalpitaciones"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:buttonTint="@color/beatwatch_blue"
                    android:paddingVertical="4dp"
                    android:text="Palpitaciones"
                    android:textColor="@color/beatwatch_dark_blue"
                    android:textSize="14sp" />

                <CheckBox
                    android:id="@+id/cbDolorPecho"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:buttonTint="@color/beatwatch_blue"
                    android:paddingVertical="4dp"
                    android:text="Dolor en pecho"
                    android:textColor="@color/beatwatch_dark_blue"
                    android:textSize="14sp" />

                <CheckBox
                    android:id="@+id/cbDesmayo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:buttonTint="@color/beatwatch_blue"
                    android:paddingVertical="4dp"
                    android:text="Desmayo"
                    android:textColor="@color/beatwatch_dark_blue"
                    android:textSize="14sp" />

                <CheckBox
                    android:id="@+id/cbFaltaAire"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:buttonTint="@color/beatwatch_blue"
                    android:paddingVertical="4dp"
                    android:text="Falta de aire"
                    android:textColor="@color/beatwatch_dark_blue"
                    android:textSize="14sp" />

                <CheckBox
                    android:id="@+id/cbFatiga"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:buttonTint="@color/beatwatch_blue"
                    android:paddingVertical="4dp"
                    android:text="Fatiga"
                    android:textColor="@color/beatwatch_dark_blue"
                    android:textSize="14sp" />
            </LinearLayout>

            <!-- ==================== FACTORES DE RIESGO ==================== -->
            <TextView
                style="@style/LabelForm"
                android:layout_marginTop="12dp"
                android:text="@string/factores_title" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:lineSpacingExtra="4dp"
                android:text="@string/factores_descripcion"
                android:textColor="#6B7A90"
                android:textSize="13sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="8dp"
                android:orientation="vertical">

                <CheckBox
                    android:id="@+id/cbHipertension"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:buttonTint="@color/beatwatch_blue"
                    android:paddingVertical="6dp"
                    android:text="Hipertensión arterial"
                    android:textColor="@color/beatwatch_dark_blue"
                    android:textSize="14sp" />

                <CheckBox
                    android:id="@+id/cbObesidad"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:buttonTint="@color/beatwatch_blue"
                    android:paddingVertical="6dp"
                    android:text="Obesidad o IMC elevado"
                    android:textColor="@color/beatwatch_dark_blue"
                    android:textSize="14sp" />

                <CheckBox
                    android:id="@+id/cbApnea"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:buttonTint="@color/beatwatch_blue"
                    android:paddingVertical="6dp"
                    android:text="Apnea del sueño"
                    android:textColor="@color/beatwatch_dark_blue"
                    android:textSize="14sp" />

                <CheckBox
                    android:id="@+id/cbTabaquismo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:buttonTint="@color/beatwatch_blue"
                    android:paddingVertical="6dp"
                    android:text="Tabaquismo"
                    android:textColor="@color/beatwatch_dark_blue"
                    android:textSize="14sp" />

                <CheckBox
                    android:id="@+id/cbAlcoholismo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:buttonTint="@color/beatwatch_blue"
                    android:paddingVertical="6dp"
                    android:text="Alcoholismo"
                    android:textColor="@color/beatwatch_dark_blue"
                    android:textSize="14sp" />

                <CheckBox
                    android:id="@+id/cbEstres"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:buttonTint="@color/beatwatch_blue"
                    android:paddingVertical="6dp"
                    android:text="Estrés crónico"
                    android:textColor="@color/beatwatch_dark_blue"
                    android:textSize="14sp" />
            </LinearLayout>

            <!-- ==================== BOTÓN CONTINUAR ==================== -->
            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnContinuarArritmia"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="22dp"
                android:background="@drawable/bg_primary_button"
                android:text="@string/registro_continuar"
                android:textAllCaps="false"
                android:textColor="@color/white"
                android:textSize="15sp"
                android:textStyle="bold" />

        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>
